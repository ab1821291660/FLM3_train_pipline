{
  "model": {
    "vocab_size": 259,
    "hidden_size": 64,
    "intermediate_size": 160,
    "num_hidden_layers": 6,
    "num_attention_heads": 4,
    "num_key_value_heads": 2,
    "max_position_embeddings": 256,
    "conv_kernel_size": 7,
    "sliding_window": 32,
    "global_partial_rotary_factor": 0.5,
    "layer_types": [
      "conv",
      "conv",
      "full_attention",
      "conv",
      "sliding_attention",
      "conv"
    ]
  },
  "training": {
    "seed": 42,
    "batch_size": 2,
    "max_seq_length": 224,
    "weight_decay": 0.01,
    "gradient_clip": 1.0,
    "stages": {
      "pretrain": {"learning_rate": 0.001, "max_steps": 10, "objective": "causal_lm"},
      "midtrain": {"learning_rate": 0.0008, "max_steps": 10, "objective": "causal_lm_agentic"},
      "sft": {"learning_rate": 0.0005, "max_steps": 10, "objective": "assistant_only_ce"},
      "mixed_rl": {"learning_rate": 0.0002, "max_steps": 10, "objective": "group_relative_offline", "beta": 0.04},
      "mopd": {"learning_rate": 0.0005, "max_steps": 10, "objective": "specialist_response_distillation"},
      "agentic_rl": {"learning_rate": 0.0001, "max_steps": 10, "objective": "group_relative_tool_reward", "beta": 0.04}
    }
  }
}
